<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500" prefWidth="690" spacing="14" styleClass="screen-Background" stylesheets="@../stylesheets/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.easyconnect.controller.PatientMedicationsController">
    <padding>
        <Insets bottom="24" top="60" />
    </padding>

    <Label styleClass="headerMain-Text" stylesheets="@../stylesheets/styles.css" text="Medications">
        <VBox.margin><Insets left="45" /></VBox.margin>
    </Label>


    <VBox maxHeight="330" minHeight="120" spacing="10" style="-fx-background-radius: 20;" styleClass="component-Background" stylesheets="@../stylesheets/styles.css">
        <VBox.margin><Insets left="45" right="80" /></VBox.margin>
        <padding><Insets bottom="18" left="20" right="20" top="18" /></padding>

        <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-underline: true;" text="Medication(s):" />
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
            <content>
                <VBox fx:id="medicationList" spacing="3" style="-fx-background-color: transparent;" />
            </content>
        </ScrollPane>
    </VBox>
</VBox>
