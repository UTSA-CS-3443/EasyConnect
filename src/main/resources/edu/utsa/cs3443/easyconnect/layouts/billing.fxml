<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500" prefWidth="690" spacing="14" styleClass="screen-Background" stylesheets="@../stylesheets/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.easyconnect.controller.PatientBillingController">
    <padding>
        <Insets bottom="24" left="30" right="30" top="24" />
    </padding>

    <Label styleClass="headerMain-Text" text="Billing" />

    <HBox spacing="45">
        <VBox prefHeight="140" prefWidth="366" spacing="6" style="-fx-background-radius: 20;" styleClass="component-Background">
            <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
            <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 16px;" text="Your Next Payment is Due on:" />
            <Label fx:id="dueDateLabel" alignment="CENTER" maxWidth="Infinity" style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 16px; -fx-font-weight: bold;" text="Due date here">
                <VBox.margin><Insets top="22" /></VBox.margin>
            </Label>
        </VBox>
        <VBox prefHeight="140" prefWidth="210" spacing="6" style="-fx-background-radius: 20;" styleClass="component-Background">
            <padding><Insets bottom="14" left="14" right="14" top="14" /></padding>
            <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 16px;" text="Balance Due:" />
            <Label fx:id="balanceDueLabel" alignment="CENTER" maxWidth="Infinity" style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 16px; -fx-font-weight: bold;" text="Amount here">
                <VBox.margin><Insets top="22" /></VBox.margin>
            </Label>
        </VBox>
    </HBox>
   <VBox maxWidth="-Infinity" minWidth="-Infinity" prefHeight="118.0" prefWidth="242.0">
      <VBox.margin>
         <Insets left="380.0" />
      </VBox.margin>
      <children>
         <Button maxWidth="-Infinity" mnemonicParsing="false" onAction="#makePayment" prefHeight="29.0" prefWidth="169.0" stylesheets="@../stylesheets/styles.css" text="Make Payment">
            <styleClass>
               <String fx:value="button-Background" />
               <String fx:value="button-Text" />
            </styleClass>
            <VBox.margin>
               <Insets left="55.0" top="40.0" />
            </VBox.margin>
         </Button>
      </children>
   </VBox>
</VBox>
