<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="690" prefHeight="500"
      spacing="25"
      styleClass="screen-Background"
      stylesheets="@../stylesheets/styles.css"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utsa.cs3443.easyconnect.controller.DoctorDashboardController">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35" />
    </padding>

    <Label text="Dashboard" styleClass="headerMain-Text" />

    <HBox alignment="CENTER">
        <VBox spacing="15" prefWidth="300" styleClass="component-Background">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            <Label text="Today's appointments:" styleClass="component-Header-Text" />
            <ScrollPane fitToWidth="true" prefHeight="120">
                <content>
                    <Label fx:id="appointmentsLabel" wrapText="true"
                           styleClass="component-Text" />
                </content>
            </ScrollPane>
        </VBox>

    </HBox>

    <VBox spacing="20" styleClass="component-Background">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20" />
        </padding>
        <Label text="Quick Actions" styleClass="component-Header-Text" />
        <HBox spacing="20">
            <Button text="Lookup patient" prefWidth="250" prefHeight="40"
                    styleClass="button-Background, button-Text"
                    onAction="#onPatientLookupButtonClick" />
            <Button text="Write Patient Notes" prefWidth="250" prefHeight="40"
                    styleClass="button-Background, button-Text"
                    onAction="#onNoteButtonClick" />
        </HBox>
    </VBox>
</VBox>
