<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="690" prefHeight="500" spacing="20"
      styleClass="screen-Background" stylesheets="@../stylesheets/styles.css"
      xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="30" right="35" bottom="30" left="35" />
    </padding>

    <Label text="Write Notes" styleClass="headerMain-Text" />

    <VBox spacing="10" styleClass="component-Background">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20" />
        </padding>
        <Label text="Patient ID" styleClass="component-Header-Text" />
        <TextField fx:id="patientField" promptText="Enter patient ID" />
        <Label text="Doctor ID" styleClass="component-Header-Text" />
        <TextField fx:id="doctorIdField" editable="false" promptText="Logged-in doctor ID" />
        <Label text="Note" styleClass="component-Header-Text" />
        <TextArea fx:id="recommendationArea" prefRowCount="4" wrapText="true" promptText="Write a patient note" />
        <Button fx:id="saveNoteButton" text="Save to patient"
                styleClass="button-Background, button-Text" />
    </VBox>
</VBox>
