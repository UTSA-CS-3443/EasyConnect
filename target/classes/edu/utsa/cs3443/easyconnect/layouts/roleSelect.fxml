<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="500" prefWidth="860.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.easyconnect.controller.roleSelectController">
   <children>
      <VBox layoutY="-1.0" prefHeight="500.0" prefWidth="862.0" style="-fx-background-color: #FFFFFF;">
         <children>
            <ImageView fitHeight="87.0" fitWidth="127.0" pickOnBounds="true" preserveRatio="true">
               <VBox.margin>
                  <Insets left="380.0" top="150.0" />
               </VBox.margin>
               <image>
                  <Image url="@../assets/Logo.png" />
               </image>
            </ImageView>
            <HBox prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #FFFFFF;">
               <children>
                  <Button defaultButton="true" onAction="#patientLogin" prefHeight="38" prefWidth="210" style="-fx-background-radius: 24; -fx-border-radius: 24; -fx-font-weight: bold;" styleClass="headerMain-Background" stylesheets="@../stylesheets/styles.css" text="Patient" textFill="NAVY">
                     <font>
                        <Font size="20.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="120.0" top="30.0" />
                     </HBox.margin>
                  </Button>
                  <Button defaultButton="true" onAction="#doctorLogin" prefHeight="38" prefWidth="210" style="-fx-background-radius: 24; -fx-border-radius: 24; -fx-font-weight: bold;" styleClass="headerMain-Background" stylesheets="@../stylesheets/styles.css" text="Doctor" textFill="NAVY">
                     <font>
                        <Font size="20.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="180.0" top="30.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
