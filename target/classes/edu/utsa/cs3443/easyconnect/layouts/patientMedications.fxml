<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="500" prefWidth="690" style="-fx-background-color: #F1F1F1; -fx-background: #F1F1F1; -fx-padding: 0;" stylesheets="@../stylesheets/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.easyconnect.controller.PatientMedicationsController">
    <content>
        <VBox spacing="14" styleClass="screen-Background">
            <padding>
                <Insets bottom="24" top="60" />
            </padding>

            <Label styleClass="headerMain-Text" text="Medications">
                <VBox.margin><Insets left="45" /></VBox.margin>
            </Label>


            <VBox minHeight="120" spacing="10" style="-fx-background-radius: 20;" styleClass="component-Background">
                <VBox.margin><Insets left="45" right="80" /></VBox.margin>
                <padding><Insets bottom="18" left="20" right="20" top="18" /></padding>

                <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-underline: true;" text="Medication(s):" />

                <VBox fx:id="medicationList" spacing="3" />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
