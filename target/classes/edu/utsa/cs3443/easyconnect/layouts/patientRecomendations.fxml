<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="500.0" prefWidth="690.0" style="-fx-background-color: #F1F1F1; -fx-background: #F1F1F1; -fx-padding: 0;" stylesheets="@../stylesheets/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.easyconnect.controller.PatientRecomendationController">
    <content>
        <VBox spacing="14.0" styleClass="screen-Background">
            <padding>
                <Insets bottom="24.0" top="60.0" />
            </padding>

            <Label styleClass="headerMain-Text" text="Doctor’s Note">
                <VBox.margin>
                    <Insets left="45.0" />
                </VBox.margin>
            </Label>

            <VBox minHeight="120.0" spacing="10.0" style="-fx-background-radius: 20;" styleClass="component-Background">
                <VBox.margin>
                    <Insets left="45.0" right="80.0" />
                </VBox.margin>
                <padding>
                    <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
                </padding>

                <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-underline: true;" text="Recommendations(s):" />

                <VBox fx:id="recommendationList" spacing="4.0" />
            </VBox>
        </VBox>
    </content>
</ScrollPane>