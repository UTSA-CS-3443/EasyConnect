<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="500" prefWidth="690" style="-fx-background-color: #F1F1F1; -fx-background: #F1F1F1; -fx-padding: 0;" stylesheets="@../stylesheets/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.easyconnect.controller.PatientFormController">
    <content>
        <VBox spacing="20" styleClass="screen-Background">
            <padding>
                <Insets bottom="30" top="60" />
            </padding>


            <Label styleClass="headerMain-Text" text="Medical Record">
                <VBox.margin><Insets left="45" /></VBox.margin>
            </Label>


            <VBox minHeight="120" spacing="10" style="-fx-background-radius: 20;" styleClass="component-Background">
                <VBox.margin><Insets left="45" right="80" /></VBox.margin>
                <padding><Insets bottom="18" left="20" right="20" top="18" /></padding>

                <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-underline: true;" text="Symptom(s):" />

                <VBox fx:id="symptomList" spacing="4" />


                <HBox fx:id="symptomInputRow" managed="false" spacing="10" visible="false">
                    <TextField fx:id="symptomInput" promptText="Enter a symptom..." HBox.hgrow="ALWAYS" />
                    <Button onAction="#onAddSymptom" styleClass="button-Background, button-Text" text="Add" />
                </HBox>
            </VBox>


            <VBox minHeight="120" spacing="10" style="-fx-background-radius: 20;" styleClass="component-Background">
                <VBox.margin><Insets left="45" right="80" /></VBox.margin>
                <padding><Insets bottom="18" left="20" right="20" top="18" /></padding>

                <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-underline: true;" text="Medical History:" />

                <VBox fx:id="medicalHistoryList" spacing="4" />


                <HBox fx:id="historyInputRow" managed="false" spacing="10" visible="false">
                    <TextField fx:id="historyInput" promptText="Enter medical history..." HBox.hgrow="ALWAYS" />
                    <Button onAction="#onAddHistory" styleClass="button-Background, button-Text" text="Add" />
                </HBox>
            </VBox>


            <VBox minHeight="120" spacing="10" style="-fx-background-radius: 20;" styleClass="component-Background">
                <VBox.margin><Insets left="45" right="80" /></VBox.margin>
                <padding><Insets bottom="18" left="20" right="20" top="18" /></padding>

                <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-underline: true;" text="Current Medication(s):" />

                <VBox fx:id="currentMedicationList" spacing="4" />


                <HBox fx:id="medicationInputRow" managed="false" spacing="10" visible="false">
                    <TextField fx:id="medicationInput" promptText="Enter medication and dosage..." HBox.hgrow="ALWAYS" />
                    <Button onAction="#onAddMedication" styleClass="button-Background, button-Text" text="Add" />
                </HBox>
            </VBox>

            <HBox alignment="CENTER_RIGHT">
                <VBox.margin><Insets left="45" right="80" /></VBox.margin>
                <Button fx:id="saveButton" managed="false" onAction="#onSaveRecord" style="-fx-font-size: 16px;" text="Save Medical Record" visible="false">
                    <styleClass>
                        <String fx:value="button-Background" />
                        <String fx:value="button-Text" />
                    </styleClass>
                </Button>
            </HBox>
        </VBox>
    </content>
</ScrollPane>